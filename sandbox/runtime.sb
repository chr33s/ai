(version 1)

(deny default)
(import "system.sb")

(define app-root (param "APP_ROOT"))
(define data-root (param "DATA_ROOT"))
(define model-root (param "MODEL_ROOT"))
(define cache-root (param "CACHE_ROOT"))
(define tmp-root (param "TMP_ROOT"))

; Restrict execution to the explicit command passed by the wrapper.
(allow process-exec (literal (param "EXECUTABLE")))

; Read-only inputs: app code, models, runtime libraries, and system state.
(allow file-read*
  (subpath app-root)
  (subpath model-root)
  (subpath "/System")
  (subpath "/Library")
  (subpath "/usr/lib")
  (subpath "/opt/homebrew")
  (subpath "/private/var/db/dyld")
  (subpath "/dev"))

; Writable state is limited to explicit working directories.
(allow file-write*
  (subpath data-root)
  (subpath cache-root)
  (subpath tmp-root)
  (literal "/dev/null"))

; Runtime profile stays offline.
(deny network*)
